{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "infrapilot-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "src/Platform.Web"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "infrapilot-api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "src/Platform.Api/Platform.Api.csproj",
        "--",
        "--ConnectionStrings:Platform",
        "Host=localhost;Port=5433;Database=swo_platform;Username=postgres;Password=postgres"
      ],
      "port": 5259
    }
  ]
}
